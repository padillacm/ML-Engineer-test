# Configuration of the stack (docker-compose.yml). Copy to `.env` and uncomment what you change:
#   cp .env.example .env
# `.env` is git- and docker-ignored; never commit it. The stack also starts without it.
# Every line below is commented out and shows the default, so a copied file changes nothing and
# later default changes still apply. An empty value counts as unset (the default applies).
# Compose reads this file for its own ${...} values; docker-compose.yml passes the app only the
# settings below (and the keys as secret files), so other variables here never reach it.
# Quote values that contain `$` in single quotes, for example LLM_API_KEY='abc$def': compose
# reads `$def` in an unquoted or double-quoted value as a variable and silently replaces it.
# tests/deploy/test_env_example.py checks that every setting of app/settings.py and every
# variable of the compose files is listed here, with its current default, and no secret has a value.

# --- Compose -------------------------------------------------------------------------------------
# Image name of the built service (docker compose build tags it).
# APP_IMAGE=docintel
# Host interface and port of the service. The service has no authentication: keep 127.0.0.1
# unless a reverse proxy with TLS and auth sits in front of it.
# APP_BIND=127.0.0.1
# APP_PORT=8000
# Profiles of `docker compose up`; `gpu` (the only one) adds Ollama on the NVIDIA GPU and points
# the service at it. Set it here or in the environment: `--profile gpu` alone cannot point the
# service at Ollama, so its model download then stops with an error.
# COMPOSE_PROFILES=gpu
# First three numbers of the stack's internal /24 network (Ollama has the fixed address .250).
# Change it when compose reports that the subnet overlaps another network.
# BACKEND_NETWORK_PREFIX=10.213.47
# Image of the smoke tests (docker-compose.smoke.yml builds it).
# TEST_IMAGE=docintel-test

# --- Local language model (profile `gpu`) --------------------------------------------------------
# The model Ollama pulls (once, into the ollama_models volume) and the app asks. Leave
# LLM_BASE_URL unset: with COMPOSE_PROFILES=gpu the app is pointed at Ollama's fixed address.
# LLM_MODEL=gemma4:e4b-it-qat
# Server-side context window in tokens: must hold the largest prompt plus the answer.
# OLLAMA_CONTEXT_LENGTH=8192
# Requests the loaded model serves at once (each one needs its own context in VRAM).
# OLLAMA_NUM_PARALLEL=2
# Models kept in VRAM at once.
# OLLAMA_MAX_LOADED_MODELS=1
# How long the model stays loaded after the last request (-1: always).
# OLLAMA_KEEP_ALIVE=-1

# --- Hosted OpenAI-compatible model (instead of the `gpu` profile) -------------------------------
# Uncomment all three and set the model name and your key (in single quotes if it contains `$`).
# Without LLM_BASE_URL (and without the profile) there is no model: questions that need one
# answer 503 llm_unavailable.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# LLM_API_KEY=
# docker-compose.yml hands LLM_API_KEY to the app as a secret file (/run/secrets/llm_api_key)
# and sets LLM_API_KEY_FILE to it, so the key is not in the container's environment (`docker
# inspect`) nor in `docker compose config`. Outside compose, set either LLM_API_KEY or
# LLM_API_KEY_FILE (a file holding only the key; an empty file means no key), not both.
# LLM_API_KEY_FILE=
# Reasoning models (for example gpt-6-luna) reject `max_tokens` and any temperature but their
# default: for them also set LLM_MAX_TOKENS_FIELD to max_completion_tokens and
# LLM_SEND_TEMPERATURE to false (see "Language model client" below).

# --- Language model client -----------------------------------------------------------------------
# LLM_CONNECT_TIMEOUT_S=5.0
# LLM_READ_TIMEOUT_S=60.0
# Whole call including retries.
# LLM_TOTAL_TIMEOUT_S=90.0
# LLM_ATTEMPTS=3
# Longest reply in tokens; a thinking model's reasoning counts against it.
# LLM_MAX_TOKENS=512
# Sent as `reasoning_effort` only when set: none, minimal, low, medium, high or xhigh. `none`
# turns thinking off on Ollama; when the service uses the stack's Ollama, compose sets none
# unless this sets a value.
# LLM_REASONING_EFFORT=
# Name of the reply limit in the request: max_tokens, or max_completion_tokens (reasoning models).
# LLM_MAX_TOKENS_FIELD=max_tokens
# Send `temperature` (0); false leaves it out, for models that accept only their default.
# LLM_SEND_TEMPERATURE=true

# --- Models ------------------------------------------------------------------------------------
# The three model variables are set by the image (the models are baked in); docker-compose.yml
# does not pass them, so they only matter outside compose. The revision is the embedding model's
# pinned commit, part of the index identity.
# NER_MODEL_PATH=/models/xlm-roberta-base-ner-hrl
# EMBEDDING_MODEL_PATH=/models/multilingual-e5-base
# EMBEDDING_MODEL_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
# Torch intra-op threads, shared by the NER model and the embedder (process-wide); empty = 2, or
# 1 on a single CPU.
# TORCH_THREADS=
# Concurrency settings left empty are derived at start-up from the CPUs available to the
# container (affinity and CPU quota) and logged ("concurrency in use"); a value set here wins.
# 16 CPUs give 12 jobs / NER pool 8 / embedder pool 4 / 4 OCR workers, 8 CPUs 6 / 4 / 2 / 4,
# 4 CPUs 3 / 2 / 1 / 4 (docs/BENCHMARKS.md 17.4 and 18).
# Concurrent NER recognitions; empty = CPUs / TORCH_THREADS, at most 8. A pool x TORCH_THREADS
# above the CPUs logs a warning.
# NER_POOL_SIZE=
# Concurrent passage batches of the embedder (one shared model; one more slot is reserved for
# questions); empty = CPUs / (2 x TORCH_THREADS), at most 4.
# EMBEDDING_POOL_SIZE=
# EMBEDDING_BATCH_SIZE=16

# --- OCR -----------------------------------------------------------------------------------------
# OCR_DPI=200
# Parallel Tesseract processes per document; empty = min(4, CPUs available).
# OCR_WORKERS=
# OCR_TIMEOUT_S=60.0
# OCR_FLATTEN=true
# MAX_PAGES=50

# --- Name matching -------------------------------------------------------------------------------
# MATCH_THRESHOLD=0.90

# --- Chunking and retrieval ----------------------------------------------------------------------
# CHUNK_SIZE=800
# Overlap as a ratio of CHUNK_SIZE (not characters).
# CHUNK_OVERLAP=0.12
# Top-1 cosine below this refuses the question without asking the model.
# RAG_THRESHOLD=0.808
# RAG_TOP_K=5
# RAG_MAX_CHUNKS=3
# RAG_MAX_CONTEXT_CHARS=6000

# --- Vector store --------------------------------------------------------------------------------
# docker-compose.yml sets QDRANT_URL=http://qdrant:6333 for the app (a value here is overridden);
# QDRANT_LOCATION (an embedded store) is for running the app outside compose.
# QDRANT_URL=
# QDRANT_LOCATION=
# Qdrant's key. docker-compose.yml then makes its Qdrant require it and hands it to the service
# as a secret file (/run/secrets/qdrant_api_key, QDRANT_API_KEY_FILE), as for LLM_API_KEY.
# Outside compose, set either QDRANT_API_KEY or QDRANT_API_KEY_FILE, not both.
# QDRANT_API_KEY=
# QDRANT_API_KEY_FILE=
# QDRANT_COLLECTION_PREFIX=chunks
# QDRANT_TIMEOUT_S=10.0
# QDRANT_ATTEMPTS=3
# QDRANT_DEADLINE_S=20.0

# --- Limits --------------------------------------------------------------------------------------
# MAX_UPLOAD_MB=20
# MAX_NAMES=1000
# Concurrent extraction and ingestion jobs; further requests wait up to BUSY_WAIT_S, then 503.
# Empty = three quarters of the CPUs (rounded up), at most 12.
# MAX_CONCURRENT_JOBS=
# MAX_CONCURRENT_QUESTIONS=16
# BUSY_WAIT_S=10.0
# READINESS_TIMEOUT_S=2.0

# --- Logging -------------------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json
# Local debugging only: logged tracebacks then include exception messages (personal data).
# LOG_EXCEPTION_MESSAGES=false
