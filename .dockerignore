# VCS, local environments and caches
.git
.gitignore
.gitattributes
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.coverage.*
htmlcov
*.egg-info

# Not needed to build or test (sample_pdfs/ IS needed: integration tests read it)
benchmarks
docs
openspec
.claude
.idea
.vscode

# Secrets, in any directory (the example holds placeholders only; the test image's suite checks
# it). A pattern without **/ matches only at the root of the build context.
**/.env
**/.env.*
!**/.env.example

# Docker files themselves
Dockerfile
.dockerignore
